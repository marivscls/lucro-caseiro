# Lucro Caseiro API - environment variables
# Copy to .env and fill in values for local dev. For production, set these in your host (Railway/Fly/Render).

# Runtime
NODE_ENV=production
API_PORT=3001

# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
# Service-role key (Dashboard -> Project Settings -> API -> service_role).
# Usada por exclusao de conta e pelo worker privado do Editor Autonomo de Video. SEGREDO:
# nunca commitar, nunca expor ao mobile.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# UUIDs de contas autorizadas a abrir o painel interno de métricas.
# Supabase Dashboard -> Authentication -> Users -> coluna User UID.
ADMIN_USER_IDS=

# Central de Marketing privada: UUIDs do Supabase Auth autorizados, separados por vírgula.
# Em produção, lista vazia nega todo acesso às rotas /api/v1/marketing.
MARKETING_USER_IDS=

# IA da Central de Marketing (Gemini, somente no servidor).
GOOGLE_GENERATIVE_AI_API_KEY=

# Editor Autonomo de Video (GPT + render local, somente no servidor).
OPENAI_API_KEY=
VIDEO_EDITOR_FFMPEG_PATH=ffmpeg
VIDEO_EDITOR_FFPROBE_PATH=ffprobe

# Consulta opcional de produtos por GTIN/EAN (Cosmos/Bluesoft).
# Sem as duas variaveis, o fluxo segue com cadastro manual.
COSMOS_API_TOKEN=
COSMOS_USER_AGENT=

# Boas-vindas: ativar somente no ambiente de produção desejado.
# Registra o início uma única vez e considera apenas novos cadastros confirmados.
WELCOME_EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Lucro Caseiro <notificacoes@lucrocaseiro.com.br>
EMAIL_REPLY_TO=contato@orionseven.com.br

# CORS - lista explicita, separada por virgulas. "*" e recusado em producao.
# Apps nativos nao enviam Origin e continuam aceitos.
CORS_ORIGIN=https://lucrocaseiro.com.br,https://www.lucrocaseiro.com.br,https://lucrocaseiro.app

# Google Play Billing validation
GOOGLE_PLAY_PACKAGE_NAME=br.com.orionseven.lucrocaseiro
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Stripe Billing / Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL_MONTHLY_ID=
STRIPE_PRICE_ESSENTIAL_ANNUAL_ID=
STRIPE_PRICE_PROFESSIONAL_MONTHLY_ID=
STRIPE_PRICE_PROFESSIONAL_ANNUAL_ID=
STRIPE_SUCCESS_URL=https://lucrocaseiro.app/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://lucrocaseiro.app/checkout/cancel

# Browser Web Push (generate once with: pnpm exec web-push generate-vapid-keys)
# Keep the private key only on the API. Use a real support contact as subject.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
