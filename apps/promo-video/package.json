{
  "name": "promo-video",
  "version": "1.0.0",
  "description": "Vídeo promocional vertical do Lucro Caseiro",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/captions": "4.0.489",
    "@remotion/cli": "4.0.489",
    "@remotion/media": "4.0.489",
    "@remotion/transitions": "4.0.489",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.489"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.489",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render LucroCaseiroPromo out/lucro-caseiro-promo.mp4",
    "render:avatar-demo": "remotion render LucroCaseiroAvatarDemo out/lucro-caseiro-avatar-demo-ptbr-corrigido.mp4",
    "render:campaigns": "remotion render LucroCaseiroFinanceiro out/lucro-caseiro-financeiro.mp4 && remotion render LucroCaseiroCatalogo out/lucro-caseiro-catalogo.mp4 && remotion render LucroCaseiroProfissional out/lucro-caseiro-profissional.mp4",
    "render:tour": "remotion render LucroCaseiroTourReal out/lucro-caseiro-tour-real.mp4",
    "render:play-store": "remotion render LucroCaseiroPlayStore out/lucro-caseiro-play-store.mp4"
  },
  "sideEffects": [
    "*.css"
  ],
  "overrides": {
    "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "browserslist@<4.28.7": "4.28.7",
    "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "nanoid@>=3.0.0 <3.3.18": "3.3.18",
    "postcss@<8.5.25": "8.5.25"
  }
}
